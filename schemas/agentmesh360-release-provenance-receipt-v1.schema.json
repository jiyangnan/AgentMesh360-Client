{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmesh360.com/schemas/release-provenance-receipt-v1.json",
  "title": "AgentMesh360 P3 R2 E0 Release Provenance Receipt v1",
  "description": "Retention-safe evidence for one approved local four-Agent deterministic build and test-signing rehearsal. It cannot close production R2.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "rehearsalId",
    "environment",
    "workPackage",
    "authority",
    "approvalStatus",
    "executionStatus",
    "algorithm",
    "approvalReceipt",
    "candidateFreeze",
    "executorFreeze",
    "sourceInputs",
    "roleAliases",
    "testPublisher",
    "agentResults",
    "cleanup",
    "productionBoundary",
    "evidencePolicy",
    "reviewLimitations",
    "completedAt"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "rehearsalId": {
      "type": "string",
      "pattern": "^release_provenance_e0_[a-z0-9][a-z0-9_-]{7,63}$"
    },
    "environment": {
      "type": "string",
      "const": "e0"
    },
    "workPackage": {
      "type": "string",
      "const": "p3_r2"
    },
    "authority": {
      "type": "string",
      "const": "single_test_publisher"
    },
    "approvalStatus": {
      "type": "string",
      "const": "approved"
    },
    "executionStatus": {
      "type": "string",
      "const": "technical_rehearsal_passed"
    },
    "algorithm": {
      "type": "string",
      "const": "ed25519"
    },
    "approvalReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receiptId",
        "authorizedScope",
        "authorizedCandidateCommit",
        "authorizedPublisherKeyCount",
        "authorizedWindow",
        "externalServicesUsed",
        "providerRequests",
        "creditsConsumed",
        "currencyCost"
      ],
      "properties": {
        "receiptId": {
          "type": "string",
          "pattern": "^approval_p3_e0_[a-z0-9][a-z0-9_-]{7,63}$"
        },
        "authorizedScope": {
          "type": "string",
          "const": "p3_r2_e0_four_agent_dual_build_and_test_signing"
        },
        "authorizedCandidateCommit": {
          "type": "string",
          "const": "e1ef8db19dc58a2c9cec19ac34f7e1966d741b7c"
        },
        "authorizedPublisherKeyCount": {
          "type": "integer",
          "const": 1
        },
        "authorizedWindow": {
          "type": "string",
          "const": "current_development_cycle_only"
        },
        "externalServicesUsed": {
          "type": "boolean",
          "const": false
        },
        "providerRequests": {
          "type": "integer",
          "const": 0
        },
        "creditsConsumed": {
          "type": "integer",
          "const": 0
        },
        "currencyCost": {
          "type": "integer",
          "const": 0
        }
      }
    },
    "candidateFreeze": {
      "$ref": "#/$defs/candidateFreeze"
    },
    "executorFreeze": {
      "$ref": "#/$defs/executorFreeze"
    },
    "sourceInputs": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {
          "$ref": "#/$defs/deploySource"
        },
        {
          "$ref": "#/$defs/futureSource"
        },
        {
          "$ref": "#/$defs/jobSource"
        },
        {
          "$ref": "#/$defs/lecturecastSource"
        }
      ],
      "items": false
    },
    "roleAliases": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "type": "string",
          "const": "build_operator"
        },
        {
          "type": "string",
          "const": "independent_reviewer"
        },
        {
          "type": "string",
          "const": "test_signer_operator"
        }
      ],
      "items": false
    },
    "testPublisher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keyId",
        "publicKeySha256",
        "generationCount",
        "signatureOperationCount",
        "privateMaterialPersisted",
        "destroyed"
      ],
      "properties": {
        "keyId": {
          "type": "string",
          "pattern": "^agentmesh360-publisher-e0-p3-[a-z0-9][a-z0-9_-]{7,63}$"
        },
        "publicKeySha256": {
          "$ref": "#/$defs/typedDigest"
        },
        "generationCount": {
          "type": "integer",
          "const": 1
        },
        "signatureOperationCount": {
          "type": "integer",
          "const": 8
        },
        "privateMaterialPersisted": {
          "type": "boolean",
          "const": false
        },
        "destroyed": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "agentResults": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {
          "$ref": "#/$defs/deployResult"
        },
        {
          "$ref": "#/$defs/futureResult"
        },
        {
          "$ref": "#/$defs/jobResult"
        },
        {
          "$ref": "#/$defs/lecturecastResult"
        }
      ],
      "items": false
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "temporaryBoundaryRemoved",
        "buildRootsRemoved",
        "candidateWorktreeRemoved",
        "sourceWorktreesRemoved",
        "privateFilesRemaining",
        "repositoryPrivateMaterialDetected",
        "repositoryTargetAbsent",
        "restoredTrustState",
        "productionConstantsEmpty",
        "forensicSecureEraseGuaranteed",
        "cleanupMethod"
      ],
      "properties": {
        "temporaryBoundaryRemoved": {
          "type": "boolean",
          "const": true
        },
        "buildRootsRemoved": {
          "type": "integer",
          "const": 2
        },
        "candidateWorktreeRemoved": {
          "type": "boolean",
          "const": true
        },
        "sourceWorktreesRemoved": {
          "type": "integer",
          "const": 3
        },
        "privateFilesRemaining": {
          "type": "integer",
          "const": 0
        },
        "repositoryPrivateMaterialDetected": {
          "type": "boolean",
          "const": false
        },
        "repositoryTargetAbsent": {
          "type": "boolean",
          "const": true
        },
        "restoredTrustState": {
          "type": "string",
          "const": "empty"
        },
        "productionConstantsEmpty": {
          "type": "boolean",
          "const": true
        },
        "forensicSecureEraseGuaranteed": {
          "type": "boolean",
          "const": false
        },
        "cleanupMethod": {
          "type": "string",
          "const": "overwrite_fsync_unlink_then_recursive_remove"
        }
      }
    },
    "productionBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productionR2Closed",
        "productionKeysCreated",
        "productionRegistryPublished",
        "externalAuthorityUsed",
        "p4ThroughP8Opened"
      ],
      "properties": {
        "productionR2Closed": {
          "type": "boolean",
          "const": false
        },
        "productionKeysCreated": {
          "type": "boolean",
          "const": false
        },
        "productionRegistryPublished": {
          "type": "boolean",
          "const": false
        },
        "externalAuthorityUsed": {
          "type": "boolean",
          "const": false
        },
        "p4ThroughP8Opened": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "evidencePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "containsPrivateMaterial",
        "containsRawPublicKeys",
        "containsRawSignatures",
        "containsAbsolutePaths",
        "containsPersonalIdentity",
        "containsRawCommands"
      ],
      "properties": {
        "containsPrivateMaterial": {
          "type": "boolean",
          "const": false
        },
        "containsRawPublicKeys": {
          "type": "boolean",
          "const": false
        },
        "containsRawSignatures": {
          "type": "boolean",
          "const": false
        },
        "containsAbsolutePaths": {
          "type": "boolean",
          "const": false
        },
        "containsPersonalIdentity": {
          "type": "boolean",
          "const": false
        },
        "containsRawCommands": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "reviewLimitations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digestInputsIndependentlyVerifiable",
        "executionOccurrenceStandaloneProof",
        "trustedProducer"
      ],
      "properties": {
        "digestInputsIndependentlyVerifiable": {
          "type": "boolean",
          "const": false
        },
        "executionOccurrenceStandaloneProof": {
          "type": "boolean",
          "const": false
        },
        "trustedProducer": {
          "type": "string",
          "const": "audited_local_runner"
        }
      }
    },
    "completedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  },
  "$defs": {
    "typedDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "candidateFreeze": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "cleanTree",
        "cargoLockSha256",
        "rustcVersion",
        "cargoVersion"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "const": "e1ef8db19dc58a2c9cec19ac34f7e1966d741b7c"
        },
        "cleanTree": {
          "type": "boolean",
          "const": true
        },
        "cargoLockSha256": {
          "$ref": "#/$defs/typedDigest"
        },
        "rustcVersion": {
          "type": "string",
          "pattern": "^rustc [0-9]+\\.[0-9]+\\.[0-9]+ .{1,96}$"
        },
        "cargoVersion": {
          "type": "string",
          "pattern": "^cargo [0-9]+\\.[0-9]+\\.[0-9]+ .{1,96}$"
        }
      }
    },
    "executorFreeze": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "cleanTree",
        "cargoLockSha256",
        "executorSourceSha256"
      ],
      "properties": {
        "commit": {
          "$ref": "#/$defs/commit"
        },
        "cleanTree": {
          "type": "boolean",
          "const": true
        },
        "cargoLockSha256": {
          "$ref": "#/$defs/typedDigest"
        },
        "executorSourceSha256": {
          "$ref": "#/$defs/typedDigest"
        }
      }
    },
    "sourceInputBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agentId",
        "sourceClass",
        "sourceAlias",
        "commit",
        "cleanTree"
      ],
      "properties": {
        "agentId": {
          "type": "string"
        },
        "sourceClass": {
          "type": "string",
          "enum": [
            "dynamic_fixture",
            "first_party"
          ]
        },
        "sourceAlias": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,63}$"
        },
        "commit": {
          "$ref": "#/$defs/commit"
        },
        "cleanTree": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "deploySource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agentId",
        "sourceClass",
        "sourceAlias",
        "commit",
        "cleanTree"
      ],
      "properties": {
        "agentId": {
          "type": "string",
          "const": "deploy-agent"
        },
        "sourceClass": {
          "type": "string",
          "const": "first_party"
        },
        "sourceAlias": {
          "type": "string",
          "const": "deploy_source"
        },
        "commit": {
          "$ref": "#/$defs/commit"
        },
        "cleanTree": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "futureSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agentId",
        "sourceClass",
        "sourceAlias",
        "commit",
        "cleanTree"
      ],
      "properties": {
        "agentId": {
          "type": "string",
          "const": "future-agent"
        },
        "sourceClass": {
          "type": "string",
          "const": "dynamic_fixture"
        },
        "sourceAlias": {
          "type": "string",
          "const": "executor_fixture"
        },
        "commit": {
          "$ref": "#/$defs/commit"
        },
        "cleanTree": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "jobSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agentId",
        "sourceClass",
        "sourceAlias",
        "commit",
        "cleanTree"
      ],
      "properties": {
        "agentId": {
          "type": "string",
          "const": "job-agent"
        },
        "sourceClass": {
          "type": "string",
          "const": "first_party"
        },
        "sourceAlias": {
          "type": "string",
          "const": "job_source"
        },
        "commit": {
          "$ref": "#/$defs/commit"
        },
        "cleanTree": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "lecturecastSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agentId",
        "sourceClass",
        "sourceAlias",
        "commit",
        "cleanTree"
      ],
      "properties": {
        "agentId": {
          "type": "string",
          "const": "lecturecast-agent"
        },
        "sourceClass": {
          "type": "string",
          "const": "first_party"
        },
        "sourceAlias": {
          "type": "string",
          "const": "lecturecast_source"
        },
        "commit": {
          "$ref": "#/$defs/commit"
        },
        "cleanTree": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "outputComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outputClass",
        "byteIdentical",
        "sha256",
        "fileCount"
      ],
      "properties": {
        "outputClass": {
          "type": "string",
          "enum": [
            "artifact",
            "envelope",
            "finalize_receipt",
            "host_bundles",
            "host_projection",
            "package_file_manifest",
            "registry_record",
            "release_manifest",
            "signature_result",
            "signing_request"
          ]
        },
        "byteIdentical": {
          "type": "boolean",
          "const": true
        },
        "sha256": {
          "$ref": "#/$defs/typedDigest"
        },
        "fileCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        }
      }
    },
    "agentResultBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agentId",
        "packageId",
        "version",
        "sourceClass",
        "buildCount",
        "signingRequestCount",
        "signatureVerificationCount",
        "hostBundleCount",
        "outputComparisons",
        "status"
      ],
      "properties": {
        "agentId": {
          "type": "string"
        },
        "packageId": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "sourceClass": {
          "type": "string",
          "enum": [
            "dynamic_fixture",
            "first_party"
          ]
        },
        "buildCount": {
          "type": "integer",
          "const": 2
        },
        "signingRequestCount": {
          "type": "integer",
          "const": 2
        },
        "signatureVerificationCount": {
          "type": "integer",
          "const": 2
        },
        "hostBundleCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "outputComparisons": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/outputComparison"
          }
        },
        "status": {
          "type": "string",
          "const": "passed"
        }
      }
    },
    "deployResult": {
      "$ref": "#/$defs/agentResultBase"
    },
    "futureResult": {
      "$ref": "#/$defs/agentResultBase"
    },
    "jobResult": {
      "$ref": "#/$defs/agentResultBase"
    },
    "lecturecastResult": {
      "$ref": "#/$defs/agentResultBase"
    }
  }
}
