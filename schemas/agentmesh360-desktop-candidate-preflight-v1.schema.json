{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmesh360.com/schemas/desktop-candidate-preflight-v1.json",
  "title": "AgentMesh360 P6 R4 Desktop Candidate Preflight v1",
  "description": "No-authority preflight for a future signed and notarized macOS desktop candidate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "preflightId",
    "environment",
    "workPackage",
    "authority",
    "approvalStatus",
    "executionStatus",
    "evidenceInput",
    "prerequisiteGates",
    "currentDesktopAudit",
    "requiredP6Contract",
    "scenarioMatrix",
    "approvalCard",
    "networkBoundary",
    "evidencePolicy",
    "stopConditions",
    "nextAction"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "preflightId": {
      "type": "string",
      "pattern": "^desktop_candidate_p6_e0_[a-z0-9][a-z0-9_-]{7,63}$"
    },
    "environment": {
      "type": "string",
      "const": "e0"
    },
    "workPackage": {
      "type": "string",
      "const": "p6_r4_desktop_candidate"
    },
    "authority": {
      "type": "string",
      "const": "none"
    },
    "approvalStatus": {
      "type": "string",
      "const": "not_approved"
    },
    "executionStatus": {
      "type": "string",
      "const": "blocked"
    },
    "evidenceInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "p5AuthorizationId",
        "p5LocalCleanupSha256",
        "p5ExecutionStatus",
        "p5TemporaryEntryCount",
        "p5RetainedHostProcessCount",
        "p5ProductionMutationCount",
        "p5ProductionPackageConstantsEmpty",
        "desktopPackageJsonSha256",
        "desktopPackageLockSha256",
        "p6Authorized"
      ],
      "properties": {
        "p5AuthorizationId": {
          "type": "string",
          "const": "package_canary_e1_20260729_0002"
        },
        "p5LocalCleanupSha256": {
          "type": "string",
          "const": "sha256:fba45863add9d8eb5e2bef3510c0048cf27d08f20c46b09d83917b5314f52701"
        },
        "p5ExecutionStatus": {
          "type": "string",
          "const": "local_secret_state_destroyed"
        },
        "p5TemporaryEntryCount": {
          "type": "integer",
          "const": 0
        },
        "p5RetainedHostProcessCount": {
          "type": "integer",
          "const": 0
        },
        "p5ProductionMutationCount": {
          "type": "integer",
          "const": 0
        },
        "p5ProductionPackageConstantsEmpty": {
          "type": "boolean",
          "const": true
        },
        "desktopPackageJsonSha256": {
          "type": "string",
          "const": "sha256:5322c76bfe79b3dca1ff2feff3a814167c7859a6738ace8759ed82fe05f1c6ac"
        },
        "desktopPackageLockSha256": {
          "type": "string",
          "const": "sha256:657dc0d703596c87f840af376b66b797cca31f5e372320cdcba0a9e914a70ecc"
        },
        "p6Authorized": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "prerequisiteGates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "p5PackageCanaryEvidence",
        "r4DesktopDistributionEvidence",
        "r6OperationalReadiness",
        "p6ApprovalRequired",
        "p6ApprovalPresent",
        "productionGatesClosed"
      ],
      "properties": {
        "p5PackageCanaryEvidence": {
          "type": "string",
          "const": "e1_passed_and_cleaned"
        },
        "r4DesktopDistributionEvidence": {
          "type": "string",
          "const": "not_started"
        },
        "r6OperationalReadiness": {
          "type": "string",
          "const": "local_baseline_only"
        },
        "p6ApprovalRequired": {
          "type": "boolean",
          "const": true
        },
        "p6ApprovalPresent": {
          "type": "boolean",
          "const": false
        },
        "productionGatesClosed": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "currentDesktopAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "desktopVersion",
        "bundleId",
        "productName",
        "electronVersion",
        "electronBuilderVersion",
        "packageTargets",
        "localBuildScriptPresent",
        "hostExtraResourcePackaged",
        "loginItemLifecycleSourcePresent",
