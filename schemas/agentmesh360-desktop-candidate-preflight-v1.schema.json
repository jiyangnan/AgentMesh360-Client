      "type": "object",
      "additionalProperties": false,
      "required": [
        "recordAppleAccount",
        "recordTeamId",
        "recordCertificateIdentity",
        "recordCredentials",
        "recordAuthorizationHeaders",
        "recordEmails",
        "recordDeviceIdentifiers",
        "recordUserContent",
        "recordEndpointUrls",
        "recordAbsolutePaths",
        "recordRawNotarizationCredentials",
