        "updateChannelConfigured",
        "updateRollbackImplemented",
        "repositoryReleaseWorkflowPresent",
        "candidateBuildExecuted",
        "appleCredentialRead",
        "preflightExecutionNetworkRequestPerformed"
      ],
      "properties": {
        "desktopVersion": {
          "type": "string",
          "const": "0.1.0"
        },
        "bundleId": {
          "type": "string",
          "const": "com.agentmesh360.client"
        },
        "productName": {
          "type": "string",
          "const": "AgentMesh360"
        },
        "electronVersion": {
          "type": "string",
          "const": "43.2.0"
        },
        "electronBuilderVersion": {
          "type": "string",
          "const": "26.15.3"
        },
        "packageTargets": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "type": "string",
              "const": "dmg"
            },
            {
              "type": "string",
              "const": "zip"
            }
          ],
          "items": false
        },
        "localBuildScriptPresent": {
          "type": "boolean",
          "const": true
        },
        "hostExtraResourcePackaged": {
          "type": "boolean",
          "const": true
        },
        "loginItemLifecycleSourcePresent": {
          "type": "boolean",
          "const": true
        },
        "persistentHostLifecycleSourcePresent": {
          "type": "boolean",
          "const": true
        },
        "appleDeveloperProgramVerified": {
          "type": "boolean",
          "const": false
        },
        "developerIdIdentityInspected": {
          "type": "boolean",
          "const": false
        },
        "developerIdSigningConfigured": {
          "type": "boolean",
          "const": false
        },
        "notarizationConfigured": {
          "type": "boolean",
          "const": false
        },
        "hardenedRuntimeExplicitlyConfigured": {
          "type": "boolean",
          "const": false
        },
        "entitlementsConfigured": {
          "type": "boolean",
          "const": false
        },
        "publishProviderConfigured": {
          "type": "boolean",
          "const": false
        },
        "electronUpdaterDependencyPresent": {
          "type": "boolean",
          "const": false
        },
        "updateChannelConfigured": {
          "type": "boolean",
          "const": false
        },
        "updateRollbackImplemented": {
          "type": "boolean",
          "const": false
        },
        "repositoryReleaseWorkflowPresent": {
          "type": "boolean",
          "const": false
        },
        "candidateBuildExecuted": {
          "type": "boolean",
          "const": false
        },
        "appleCredentialRead": {
          "type": "boolean",
          "const": false
        },
        "preflightExecutionNetworkRequestPerformed": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "requiredP6Contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixedSourceCommitRequired",
        "fixedDesktopVersionRequired",
        "fixedBundleIdRequired",
        "fixedArchitectureSetRequired",
        "fixedMinimumMacOSVersionRequired",
        "developerIdApplicationRequired",
        "nestedCodeSignatureRequired",
        "hardenedRuntimeRequired",
        "leastPrivilegeEntitlementsRequired",
        "notarizationRequired",
        "stapledTicketRequired",
        "gatekeeperAssessmentRequired",
        "updateMetadataRequired",
        "updateArtifactAuthenticityRequired",
        "unsignedUpdateAllowed",
        "silentDowngradeAllowed",
        "lastKnownGoodRollbackRequired",
        "loginItemUpgradeRecoveryRequired",
        "persistentHostUpgradeRecoveryRequired",
        "uninstallUserStatePolicyRequired"
