        },
        "recordTeamId": {
          "type": "boolean",
          "const": false
        },
        "recordCertificateIdentity": {
          "type": "boolean",
          "const": false
        },
        "recordCredentials": {
          "type": "boolean",
          "const": false
        },
        "recordAuthorizationHeaders": {
          "type": "boolean",
          "const": false
        },
        "recordEmails": {
          "type": "boolean",
          "const": false
        },
        "recordDeviceIdentifiers": {
          "type": "boolean",
          "const": false
        },
        "recordUserContent": {
          "type": "boolean",
          "const": false
        },
        "recordEndpointUrls": {
          "type": "boolean",
          "const": false
        },
        "recordAbsolutePaths": {
          "type": "boolean",
          "const": false
        },
        "recordRawNotarizationCredentials": {
          "type": "boolean",
          "const": false
        },
        "recordRawUpdateMetadata": {
          "type": "boolean",
          "const": false
        },
        "typedDigestPrefix": {
          "type": "string",
          "const": "sha256:"
        }
      }
    },
    "stopConditions": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{2,95}$"
      }
    },
    "nextAction": {
      "type": "string",
      "const": "obtain_separate_p6_signing_notarization_and_update_authorization"
    }
  }
}
