        "fixedDesktopVersionRequired": {
          "type": "boolean",
          "const": true
        },
        "fixedBundleIdRequired": {
          "type": "boolean",
          "const": true
        },
        "fixedArchitectureSetRequired": {
          "type": "boolean",
          "const": true
        },
        "fixedMinimumMacOSVersionRequired": {
          "type": "boolean",
          "const": true
        },
        "developerIdApplicationRequired": {
          "type": "boolean",
          "const": true
        },
        "nestedCodeSignatureRequired": {
          "type": "boolean",
          "const": true
        },
        "hardenedRuntimeRequired": {
          "type": "boolean",
          "const": true
        },
        "leastPrivilegeEntitlementsRequired": {
          "type": "boolean",
          "const": true
        },
        "notarizationRequired": {
          "type": "boolean",
          "const": true
        },
        "stapledTicketRequired": {
          "type": "boolean",
          "const": true
        },
        "gatekeeperAssessmentRequired": {
          "type": "boolean",
          "const": true
        },
        "updateMetadataRequired": {
          "type": "boolean",
          "const": true
        },
        "updateArtifactAuthenticityRequired": {
          "type": "boolean",
          "const": true
        },
        "unsignedUpdateAllowed": {
          "type": "boolean",
          "const": false
        },
        "silentDowngradeAllowed": {
          "type": "boolean",
          "const": false
        },
        "lastKnownGoodRollbackRequired": {
          "type": "boolean",
          "const": true
        },
        "loginItemUpgradeRecoveryRequired": {
          "type": "boolean",
          "const": true
        },
        "persistentHostUpgradeRecoveryRequired": {
          "type": "boolean",
          "const": true
        },
        "uninstallUserStatePolicyRequired": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "scenarioMatrix": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario",
          "executionStatus",
          "expectedOutcome"
        ],
        "properties": {
          "scenario": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,63}$"
          },
          "executionStatus": {
            "type": "string",
            "const": "blocked"
          },
          "expectedOutcome": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,95}$"
          }
        }
      }
    },
    "approvalCard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "targetEnvironment",
        "candidateVersion",
        "sourceCommit",
        "bundleIdApproval",
        "architectureSet",
        "minimumMacOSVersion",
        "developerIdCertificate",
        "notarizationCredential",
        "updateProvider",
        "updateChannel",
        "rollbackTarget",
        "testDevicesAndCohort",
        "startStopWindow",
        "abortOwnerRole",
        "evidenceRetention",
        "maximumNetworkRequests",
        "maximumCurrencyCost",
        "approvalReceipt"
      ],
      "properties": {
        "action": {
          "type": "string",
          "const": "execute_p6_r4_desktop_candidate"
        },
        "targetEnvironment": {
          "type": "string",
          "const": "requires_approval"
        },
        "candidateVersion": {
          "type": "string",
          "const": "requires_approval"
        },
        "sourceCommit": {
          "type": "string",
          "const": "requires_approval"
        },
        "bundleIdApproval": {
          "type": "string",
          "const": "requires_approval"
        },
        "architectureSet": {
          "type": "string",
          "const": "requires_approval"
        },
        "minimumMacOSVersion": {
          "type": "string",
          "const": "requires_approval"
        },
        "developerIdCertificate": {
          "type": "string",
          "const": "requires_approval"
        },
        "notarizationCredential": {
          "type": "string",
          "const": "requires_approval"
        },
        "updateProvider": {
          "type": "string",
          "const": "requires_approval"
        },
        "updateChannel": {
          "type": "string",
          "const": "requires_approval"
        },
        "rollbackTarget": {
          "type": "string",
          "const": "requires_approval"
        },
        "testDevicesAndCohort": {
          "type": "string",
          "const": "requires_approval"
        },
        "startStopWindow": {
          "type": "string",
          "const": "requires_approval"
        },
        "abortOwnerRole": {
          "type": "string",
          "const": "requires_approval"
        },
        "evidenceRetention": {
          "type": "string",
          "const": "requires_approval"
        },
        "maximumNetworkRequests": {
          "type": "integer",
          "const": 0
        },
        "maximumCurrencyCost": {
          "type": "integer",
          "const": 0
        },
        "approvalReceipt": {
          "type": "string",
          "const": "not_present"
        }
      }
    },
    "networkBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "externalNetworkAllowed",
        "appleServiceRequestsAllowed",
        "updateProviderRequestsAllowed",
        "providerInferenceAllowed",
        "keychainReadsAllowed",
        "appleCredentialsMayBeRead",
        "externalResourcesMayBeCreated",
        "signedArtifactsMayBeProduced",
        "candidateMayBeUploaded",
        "productionConstantsMutable"
      ],
      "properties": {
        "externalNetworkAllowed": {
          "type": "boolean",
          "const": false
        },
        "appleServiceRequestsAllowed": {
          "type": "boolean",
          "const": false
        },
        "updateProviderRequestsAllowed": {
          "type": "boolean",
          "const": false
        },
        "providerInferenceAllowed": {
          "type": "boolean",
          "const": false
        },
        "keychainReadsAllowed": {
          "type": "boolean",
          "const": false
        },
        "appleCredentialsMayBeRead": {
          "type": "boolean",
          "const": false
        },
        "externalResourcesMayBeCreated": {
          "type": "boolean",
          "const": false
        },
        "signedArtifactsMayBeProduced": {
          "type": "boolean",
          "const": false
        },
        "candidateMayBeUploaded": {
          "type": "boolean",
          "const": false
        },
        "productionConstantsMutable": {
          "type": "boolean",
          "const": false
        }
      }
